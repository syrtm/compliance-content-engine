# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# --- n8n (local, self-hosted) ---
N8N_PORT=5678
GENERIC_TIMEZONE=Europe/Istanbul
TZ=Europe/Istanbul

# --- Only used by the smoke test in the README (curl) ---
# Inside n8n the key lives in an n8n "Bearer Auth" credential, not here.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
