# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# --- n8n (local, self-hosted) ---
N8N_PORT=5678
GENERIC_TIMEZONE=Europe/Istanbul
TZ=Europe/Istanbul

# --- Only used by scripts/smoke_test.py ---
# Inside n8n the key lives in an n8n "Bearer Auth" credential, not here.
# Groq free key: https://console.groq.com/keys  (or a Gemini key if you switch provider)
LLM_API_KEY=
